# Template de configuration du Backend (FastAPI)
# Renommez ce fichier en '.env' et complétez les valeurs.

# Mode débogage (True en local, False en production)
DEBUG=False

# Base de données (SQLite en local, PostgreSQL en prod)
DATABASE_URL=postgresql://user:password@host:5432/dbname

# Clé de signature JWT (générez une clé forte avec 'python -c "import secrets; print(secrets.token_hex(32))"')
# OBLIGATOIRE — l'API refuse de démarrer sans, ou avec moins de 32 caractères.
# Générer avec : openssl rand -hex 32
SECRET_KEY=
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# CORS : Origines autorisées (URLs de votre Frontend séparées par des virgules au format JSON)
CORS_ORIGINS=["https://votre-portfolio.vercel.app"]

# Envoi de formulaires de contact (Resend)
RESEND_API_KEY=re_votrekey
CONTACT_EMAIL_TO=votre.email@gmail.com

# Token d'accès personnel GitHub (PAT) pour contourner le rate limiting de l'API (recommandé)
GITHUB_TOKEN=ghp_votretokendeveloppement


# Compte administrateur créé par seed.py (à la première exécution seulement).
# ADMIN_PASSWORD fait 12 caractères minimum : openssl rand -base64 24
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=
